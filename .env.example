# Supabase Public Configuration (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Configuration (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary Storage Configuration (For article images and covers)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Deployment URL (Optional on Render)
NEXT_PUBLIC_SITE_URL=https://diwang-panlipunan.onrender.com
NODE_VERSION=20

